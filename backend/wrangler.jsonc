{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "focelle-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": ["APP_SHARED_TOKEN", "GEMINI_API_KEY"]
  },
  "vars": {
    "GEMINI_MODEL": "gemini-3.5-flash-lite"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "focelle-beta",
      "database_id": "0dcffe44-43f7-42cf-9bbc-609a364c0e0a",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "EVENT_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 0.1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
