    "beta.freeMessage" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Beta Pro is free during testing." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Beta Pro mi\u1ec5n ph\u00ed trong giai \u0111o\u1ea1n th\u1eed nghi\u1ec7m." } } } },
    "beta.endedMessage" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The free beta has ended." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Giai \u0111o\u1ea1n beta mi\u1ec5n ph\u00ed \u0111\u00e3 k\u1ebft th\u00fac." } } } },
    "common.done" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Done" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Xong" } } } },
    "onboarding.cloud" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cloud AI runs only after you tap AI. It sends a reduced preview without photo metadata." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "AI đám mây chỉ chạy khi bạn bấm AI và gửi ảnh xem trước thu nhỏ không có metadata." } } } },
    "onboarding.continue" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Camera" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Mở camera" } } } },
    "onboarding.control" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Your photos stay yours. On-device only mode and analytics controls are in Settings." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Ảnh luôn thuộc về bạn. Chế độ chỉ xử lý trên máy và tùy chọn phân tích nằm trong Cài đặt." } } } },
    "onboarding.onDevice" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Live framing and light guidance runs privately on your iPhone." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Gợi ý khung hình và ánh sáng trực tiếp được xử lý riêng tư trên iPhone." } } } },
    "onboarding.permission" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Camera permission is requested next. Photos permission is requested only when you save." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Focelle sẽ xin quyền camera tiếp theo và chỉ xin quyền Ảnh khi bạn lưu." } } } },
    "onboarding.subtitle" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A practical guide before the shutter" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chỉ dẫn thực tế trước khi bấm máy" } } } },
    "onboarding.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Meet Focelle" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Làm quen với Focelle" } } } },
    "privacy.analyticsDetail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Only anonymous feature outcomes and broad latency are eligible. Never photos, advice text, face geometry, exact location, or advertising IDs." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Ch\u1ec9 k\u1ebft qu\u1ea3 t\u00ednh n\u0103ng \u1ea9n danh v\u00e0 \u0111\u1ed9 tr\u1ec5 t\u1ed5ng qu\u00e1t. Kh\u00f4ng bao gi\u1edd g\u1eedi \u1ea3nh, n\u1ed9i dung g\u1ee3i \u00fd, h\u00ecnh h\u1ecdc khu\u00f4n m\u1eb7t, v\u1ecb tr\u00ed ch\u00ednh x\u00e1c hay m\u00e3 qu\u1ea3ng c\u00e1o." } } } },
    "privacy.analyticsTitle" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Anonymous analytics" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Ph\u00e2n t\u00edch \u1ea9n danh" } } } },
    "privacy.cloudDetail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Only after you tap AI, a reduced JPEG without EXIF metadata is sent through Focelle's proxy to Gemini. Nothing is retained by Focelle. Free-tier provider processing may be used to improve Google products." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Ch\u1ec9 sau khi b\u1ea1n b\u1ea5m AI, m\u1ed9t \u1ea3nh JPEG thu nh\u1ecf kh\u00f4ng c\u00f3 EXIF m\u1edbi \u0111\u01b0\u1ee3c g\u1eedi qua m\u00e1y ch\u1ee7 Focelle t\u1edbi Gemini. Focelle kh\u00f4ng l\u01b0u l\u1ea1i. D\u1eef li\u1ec7u tr\u00ean g\u00f3i mi\u1ec5n ph\u00ed c\u1ee7a nh\u00e0 cung c\u1ea5p c\u00f3 th\u1ec3 \u0111\u01b0\u1ee3c d\u00f9ng \u0111\u1ec3 c\u1ea3i thi\u1ec7n s\u1ea3n ph\u1ea9m Google." } } } },
    "privacy.cloudTitle" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Optional cloud AI" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "AI \u0111\u00e1m m\u00e2y t\u00f9y ch\u1ecdn" } } } },
    "privacy.onDeviceDetail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Framing, face quality, horizon, and light measurements run continuously on your iPhone and are not stored." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Khung h\u00ecnh, ch\u1ea5t l\u01b0\u1ee3ng khu\u00f4n m\u1eb7t, \u0111\u01b0\u1eddng ch\u00e2n tr\u1eddi v\u00e0 \u00e1nh s\u00e1ng \u0111\u01b0\u1ee3c \u0111o li\u00ean t\u1ee5c tr\u00ean iPhone v\u00e0 kh\u00f4ng \u0111\u01b0\u1ee3c l\u01b0u." } } } },
    "privacy.onDeviceTitle" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "On your iPhone" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Tr\u00ean iPhone c\u1ee7a b\u1ea1n" } } } },
    "privacy.photoDetail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Focelle requests camera access only when opening the camera and add-only Photos access only when saving. Existing photos are selected by you through Apple's picker." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Focelle ch\u1ec9 xin quy\u1ec1n camera khi m\u1edf camera v\u00e0 quy\u1ec1n ch\u1ec9 th\u00eam v\u00e0o \u1ea2nh khi l\u01b0u. \u1ea2nh c\u00f3 s\u1eb5n do b\u1ea1n ch\u1ecdn qua b\u1ed9 ch\u1ecdn c\u1ee7a Apple." } } } },
    "privacy.photoTitle" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Camera and Photos" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Camera v\u00e0 \u1ea2nh" } } } },
    "settings.ai" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "AI assistance" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "H\u1ed7 tr\u1ee3 AI" } } } },
    "settings.aiFooter" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "On-device only disables cloud analysis; framing guidance and filters keep working offline." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Ch\u1ec9 x\u1eed l\u00fd tr\u00ean m\u00e1y s\u1ebd t\u1eaft ph\u00e2n t\u00edch \u0111\u00e1m m\u00e2y; g\u1ee3i \u00fd khung h\u00ecnh v\u00e0 filter v\u1eabn ho\u1ea1t \u0111\u1ed9ng khi m\u1ea5t m\u1ea1ng." } } } },
    "settings.analytics" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Share anonymous analytics" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chia s\u1ebb ph\u00e2n t\u00edch \u1ea9n danh" } } } },
    "settings.camera" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Camera" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Camera" } } } },
