    "settings.onDeviceOnly" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "On-device only" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Ch\u1ec9 x\u1eed l\u00fd tr\u00ean m\u00e1y" } } } },
    "settings.privacy" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Privacy" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Quy\u1ec1n ri\u00eang t\u01b0" } } } },
    "settings.privacyDetails" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "How Focelle handles data" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "C\u00e1ch Focelle x\u1eed l\u00fd d\u1eef li\u1ec7u" } } } },
    "settings.saveLocation" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Save photo location" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "L\u01b0u v\u1ecb tr\u00ed \u1ea3nh" } } } },
    "settings.saveOriginal" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep original when using a filter" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Gi\u1eef \u1ea3nh g\u1ed1c khi d\u00f9ng filter" } } } },
