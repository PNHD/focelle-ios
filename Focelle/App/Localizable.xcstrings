    "camera.error.photosRestricted" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Photos access is restricted on this device." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Quyền Ảnh bị hạn chế trên thiết bị này." } } } },
